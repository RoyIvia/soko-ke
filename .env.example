# ============================================================
# Soko Kenya - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# PostgreSQL connection string used by Drizzle ORM and node-postgres.
#
# Local example:
# postgresql://soko_user:your_password@localhost:5432/soko_ke
#
# Production should use the appropriate managed PostgreSQL endpoint.
DATABASE_URL=postgresql://soko_user:your_password@localhost:5432/soko_ke


# ------------------------------------------------------------
# Clerk Authentication - Backend
# ------------------------------------------------------------
# Obtain these values from your Clerk application configuration.
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key


# ------------------------------------------------------------
# Clerk Authentication - Frontend
# ------------------------------------------------------------
# Vite exposes only variables prefixed with VITE_ to browser code.
# This is a publishable key and is safe to expose to the frontend.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key


# ------------------------------------------------------------
# Stripe
# ------------------------------------------------------------
# Server-side Stripe secret key.
# Never expose this value through a VITE_ variable.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key


# ------------------------------------------------------------
# API Runtime
# ------------------------------------------------------------
# Express API listening port.
PORT=8080

# development | production
NODE_ENV=development

# Pino logging level.
LOG_LEVEL=info


# ------------------------------------------------------------
# Frontend Build
# ------------------------------------------------------------
# Base path used by Vite.
# "/" is appropriate when Soko Kenya is hosted at the domain root.
BASE_PATH=/
